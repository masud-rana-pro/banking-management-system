# Copy this file to application-local.properties and provide local-only values.
# application-local.properties is intentionally ignored by Git.

spring.datasource.url=jdbc:mysql://localhost:3306/sbms
spring.datasource.username=root
spring.datasource.password=change-me

spring.mail.username=your-email@example.com
spring.mail.password=your-smtp-app-password
sbms.verification.delivery.email.enabled=true
sbms.verification.delivery.email.from-address=your-email@example.com

sbms.mail.support-email=support@example.com
sbms.mail.support-phone=
